/* =====================================================
   TWISTED TACKLEBOX STUDIOS
   MANGA / INK VISUAL DESIGN SYSTEM
   ===================================================== */


/* -----------------------------------------------------
   1. GLOBAL VARIABLES
   ----------------------------------------------------- */

:root {
    --ink: #101010;
    --ink-light: #252525;
    --paper: #eeeae0;
    --paper-dark: #d8d2c5;
    --white: #ffffff;
    --accent: #a62c32;
    --gray: #777777;

    --font-main: Arial, sans-serif;
    --font-heading: Georgia, serif;

    --panel-border: 3px solid var(--ink);
}


/* -----------------------------------------------------
   2. GLOBAL RESET
   ----------------------------------------------------- */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-main);
    overflow-x: hidden;
}

img {
    display: block;
    max-width: 100%;
}


/* -----------------------------------------------------
   3. INK TEXTURE BACKGROUND
   ----------------------------------------------------- */

.ink-background {
    background-color: var(--ink);

    background-image:
        radial-gradient(
            circle,
            rgba(255,255,255,0.13) 1px,
            transparent 1.5px
        );

    background-size: 5px 5px;
    color: var(--white);
}

.paper-texture {
    background-color: var(--paper);

    background-image:
        radial-gradient(
            rgba(0,0,0,0.12) 0.6px,
            transparent 0.8px
        );

    background-size: 4px 4px;
}

.halftone {
    background-image:
        radial-gradient(
            circle,
            var(--ink) 1px,
            transparent 1.5px
        );

    background-size: 5px 5px;
}


/* -----------------------------------------------------
   4. HEADER AND NAVIGATION
   ----------------------------------------------------- */

header {
    width: 100%;
    background: var(--ink);
    color: var(--white);
    padding: 20px 5%;
    border-bottom: 3px solid var(--accent);
}

nav {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 28px;
}

nav a {
    color: var(--white);
    text-decoration: none;
    text-transform: uppercase;
    font-weight: bold;
    letter-spacing: 2px;
    transition: color 0.2s ease;
}

nav a:hover {
    color: var(--accent);
}


/* -----------------------------------------------------
   5. MANGA PANELS
   ----------------------------------------------------- */

.manga-panel {
    position: relative;
    overflow: hidden;

    background: var(--paper);
    border: var(--panel-border);

    padding: 30px;

    box-shadow: 6px 6px 0 var(--ink);
}

.manga-panel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.manga-panel.angled {
    transform: skewX(-3deg);
}

.manga-panel.angled > * {
    transform: skewX(3deg);
}

.manga-panel.dark {
    background: var(--ink);
    color: var(--white);
}


/* -----------------------------------------------------
   6. PANEL GRID
   ----------------------------------------------------- */

.panel-grid {
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 18px;
    padding: 30px;
}

.panel-grid .manga-panel {
    min-height: 250px;
}


/* -----------------------------------------------------
   7. BRUSHSTROKE DIVIDERS
   ----------------------------------------------------- */

.ink-divider {
    height: 8px;
    width: 100%;

    background: var(--accent);

    transform: rotate(-1deg);

    margin: 25px 0;
}

.brush-heading {
    font-family: var(--font-heading);
    font-weight: 900;
    text-transform: uppercase;

    display: inline-block;

    border-bottom: 6px solid var(--accent);
    padding-bottom: 10px;
}


/* -----------------------------------------------------
   8. MANGA BUTTONS
   ----------------------------------------------------- */

.manga-button {
    display: inline-block;

    padding: 14px 28px;

    background: var(--ink);
    color: var(--white);

    border: 2px solid var(--ink);

    text-decoration: none;
    text-transform: uppercase;
    font-weight: bold;
    letter-spacing: 2px;

    transition: 0.2s ease;
}

.manga-button:hover {
    background: var(--accent);
    border-color: var(--accent);

    transform: translateY(-3px);
}


/* -----------------------------------------------------
   9. CONTENT SECTIONS
   ----------------------------------------------------- */

main {
    width: 100%;
    min-height: 70vh;
}

section {
    padding: 60px 6%;
}

footer {
    background: var(--ink);
    color: var(--white);
    padding: 35px 6%;
    text-align: center;
}


/* -----------------------------------------------------
   10. RESPONSIVE TABLET LAYOUT
   ----------------------------------------------------- */

@media (max-width: 900px) {

    .panel-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    nav {
        gap: 18px;
    }

    section {
        padding: 45px 5%;
    }

}


/* -----------------------------------------------------
   11. RESPONSIVE MOBILE LAYOUT
   ----------------------------------------------------- */

@media (max-width: 600px) {

    header {
        padding: 18px 12px;
    }

    nav {
        flex-direction: column;
        gap: 15px;
    }

    .panel-grid {
        grid-template-columns: 1fr;
        padding: 15px;
    }

    .manga-panel {
        padding: 20px;
    }

    .manga-panel.angled {
        transform: none;
    }

    .manga-panel.angled > * {
        transform: none;
    }

    section {
        padding: 35px 20px;
    }

    .brush-heading {
        font-size: 1.5rem;
    }

}

